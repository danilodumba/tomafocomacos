<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.dsdumba.tomafoco.helper</string>
    <!-- Caminho relativo ao bundle do app; o SMAppService resolve a partir daqui. -->
    <key>BundleProgram</key>
    <string>Contents/MacOS/TomafocoHelper</string>
    <key>MachServices</key>
    <dict>
        <key>com.dsdumba.tomafoco.helper</key>
        <true/>
    </dict>
    <!-- Sob demanda: o launchd sobe o helper quando o app abre a conexão e o derruba depois. -->
    <key>KeepAlive</key>
    <false/>
    <key>AssociatedBundleIdentifiers</key>
    <array>
        <string>com.dsdumba.tomafoco</string>
    </array>
</dict>
</plist>
